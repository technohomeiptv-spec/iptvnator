{
    "appId": "com.techhome.tv",
    "productName": "Tech Home TV",
    "artifactName": "TechHomeTV-${version}-${os}-${arch}.${ext}",
    "fileAssociations": [
        {
            "ext": "m3u",
            "name": "M3U Playlist",
            "description": "IPTV playlist",
            "mimeType": "audio/x-mpegurl",
            "role": "Viewer"
        },
        {
            "ext": "m3u8",
            "name": "M3U8 Playlist",
            "description": "IPTV playlist",
            "mimeType": "application/vnd.apple.mpegurl",
            "role": "Viewer"
        }
    ],
    "directories": {
        "buildResources": "dist/apps",
        "output": "dist/executables"
    },
    "files": [
        {
            "from": "dist/apps/remote-control-web",
            "to": "remote-control-web",
            "filter": ["**/*"]
        },
        "electron-backend/**/*",
        "!electron-backend/native{,/**/*}",
        "web/**/*",
        "!**/*.map"
    ],
    "asarUnpack": [
        "**/better-sqlite3/**",
        "**/bindings/**",
        "**/file-uri-to-path/**",
        "**/*.node",
        "**/*.dylib",
        "**/*.dll",
        "**/*.so",
        "**/*.so.*",
        "**/embedded-mpv-runtime.json"
    ],
    "extraMetadata": {
        "name": "techhome-tv",
        "productName": "Tech Home TV",
        "desktopName": "techhome-tv",
        "main": "electron-backend/main.js"
    },
    "extraResources": ["dist/apps/electron-backend/workers"],
    "afterPack": "./tools/packaging/electron-after-pack.cjs",
    "win": {
        "compression": "maximum",
        "target": [
            {
                "target": "nsis",
                "arch": ["x64"]
            }
        ],
        "artifactName": "TechHomeTV-Setup-${version}.${ext}",
        "icon": "apps/web/src/assets/icons/icon.png"
    },
    "nsis": {
        "oneClick": false,
        "perMachine": false,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "shortcutName": "Tech Home TV",
        "artifactName": "TechHomeTV-Setup-${version}.${ext}"
    }
}
